{
  "name": "@aribradshaw/devlog",
  "version": "1.0.4",
  "description": "Headless, project-neutral DevLog primitives for public and private software products.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "devlog-release": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./automation": {
      "types": "./dist/automation.d.ts",
      "import": "./dist/automation.js",
      "require": "./dist/automation.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/automation.ts src/cli.ts --format esm,cjs --dts --clean",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke:package": "node -e \"const api = require('./dist/index.cjs'); if (api.getDevLogPaginationItems(6, 12).length !== 7) process.exit(1)\"",
    "verify:package": "node scripts/verify-package-consumers.mjs",
    "verify": "npm run check && npm test && npm run build && npm run smoke:package && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "keywords": ["devlog", "changelog", "release-notes", "github", "headless"],
  "author": "Ari Bradshaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aribradshaw/devlog.git"
  },
  "homepage": "https://github.com/aribradshaw/devlog#readme",
  "bugs": { "url": "https://github.com/aribradshaw/devlog/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
